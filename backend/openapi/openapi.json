  "paths": {
    "/connections": {
      "get": {
        "description": "Plans journeys from `from` to `to` over the daily timetable with a bounded exhaustive search of up to 4 legs, including changes between buses at the same stop (at least `min_transfer_minutes`, staying on the same bus needs no time). With `mode=departure` it returns the first `limit` connections leaving at or after `time`; with `mode=arrival` the last `limit` connections arriving at or before `time`. Only Pareto-optimal connections are returned: a connection is dropped when another one leaves no earlier, arrives no later and changes no more often. The search looks up to 24 hours ahead (or back) and wraps past midnight; day offsets count from the search day. Connections are ordered by departure. No connection gives an empty array.",
        "operationId": "searchConnections",
        "parameters": [
          {
            "description": "Origin stop id.",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 2,
              "minimum": 1
            }
          },
          {
            "description": "Destination stop id; must differ from `from`.",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 11,
              "minimum": 1
            }
          },
          {
            "description": "Time of day `HH:MM`; defaults to the current time in Europe/Prague.",
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "type": "string",
              "example": "07:00",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          {
            "description": "`departure` (leave at or after `time`, default) or `arrival`.",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string",
              "default": "departure",
              "enum": ["departure", "arrival"]
            }
          },
          {
            "description": "Maximum number of connections, 1 to 20.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "maximum": 20,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionSearch"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query: `Missing from stop ID`, `Invalid from stop ID`, `Missing to stop ID`, `Invalid to stop ID`, `From and to must differ`, `Invalid time`, `Invalid mode` or `Invalid limit`."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The origin or destination stop does not exist (`Stop not found`)."
          }
        },
        "summary": "Search connections between two stops",
        "tags": ["Connections"]
      }
    },
