  "components": {
    "schemas": {
      "Connection": {
        "type": "object",
        "description": "One journey from the origin to the destination, possibly with transfers.",
        "properties": {
          "arrival_day_offset": {
            "type": "integer",
            "format": "int32",
            "description": "Calendar days after the search day (-1, 0, 1 or 2). A connection found for 23:50 that arrives at 00:14 has arrival offset 1; an arrival search for 00:20 may start the evening before, offset -1.",
            "example": 0,
            "minimum": -1
          },
          "arrival_time": {
            "type": "string",
            "example": "07:34",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "departure_day_offset": {
            "type": "integer",
            "format": "int32",
            "description": "Calendar days after the search day (-1, 0, 1 or 2). A connection found for 23:50 that arrives at 00:14 has arrival offset 1; an arrival search for 00:20 may start the evening before, offset -1.",
            "example": 0,
            "minimum": -1
          },
          "departure_time": {
            "type": "string",
            "example": "07:05",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "example": 29,
            "minimum": 0
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionLeg"
            }
          },
          "transfers": {
            "type": "integer",
            "format": "int32",
            "description": "Number of changes between buses.",
            "example": 1,
            "minimum": 0
          }
        },
        "required": [
          "arrival_day_offset",
          "arrival_time",
          "departure_day_offset",
          "departure_time",
          "duration_minutes",
          "legs",
          "transfers"
        ]
      },
      "ConnectionLeg": {
        "type": "object",
        "description": "One ride on one trip, from boarding to alighting.",
        "properties": {
          "arrival_day_offset": {
            "type": "integer",
            "format": "int32",
            "description": "Calendar days after the search day (-1, 0, 1 or 2). A connection found for 23:50 that arrives at 00:14 has arrival offset 1; an arrival search for 00:20 may start the evening before, offset -1.",
            "example": 0,
            "minimum": -1
          },
          "arrival_time": {
            "type": "string",
            "description": "Arrival at `to`.",
            "example": "07:11",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "block_ref": {
            "type": ["string", "null"],
            "description": "Vehicle working the trip (seed `block_ref`), shown to passengers as \"Bus B03\". Extra field beyond the contract; null when no vehicle is assigned.",
            "example": "B03",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "departure_day_offset": {
            "type": "integer",
            "format": "int32",
            "description": "Calendar days after the search day (-1, 0, 1 or 2). A connection found for 23:50 that arrives at 00:14 has arrival offset 1; an arrival search for 00:20 may start the evening before, offset -1.",
            "example": 0,
            "minimum": -1
          },
          "departure_time": {
            "type": "string",
            "description": "Departure from `from`.",
            "example": "07:05",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "destination": {
            "$ref": "#/components/schemas/StopSummary",
            "description": "Final stop of the trip (its headsign)."
          },
          "direction": {
            "type": "string",
            "description": "`outbound` travels away from the line's starting stop; `inbound` travels back towards it.",
            "enum": ["outbound", "inbound"]
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "example": 6,
            "minimum": 0
          },
          "from": {
            "$ref": "#/components/schemas/StopSummary",
            "description": "Boarding stop."
          },
          "line": {
            "$ref": "#/components/schemas/Line"
          },
          "stops": {
            "type": "array",
            "description": "Every call from `from` to `to`, both included, in travel order.",
            "items": {
              "$ref": "#/components/schemas/ConnectionStopTime"
            }
          },
          "to": {
            "$ref": "#/components/schemas/StopSummary",
            "description": "Alighting stop."
          },
          "transfer_minutes": {
            "type": ["integer", "null"],
            "format": "int32",
            "description": "Minutes waited at `from` after the previous leg arrived; null on the first leg.",
            "example": 9,
            "minimum": 0
          },
          "trip_id": {
            "type": "integer",
            "format": "int64",
            "example": 201001,
            "minimum": 1
          }
        },
        "required": [
          "arrival_day_offset",
          "arrival_time",
          "departure_day_offset",
          "departure_time",
          "destination",
          "direction",
          "duration_minutes",
          "from",
          "line",
          "stops",
          "to",
          "transfer_minutes",
          "trip_id"
        ]
      },
