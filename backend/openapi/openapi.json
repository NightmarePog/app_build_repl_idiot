{
  "openapi": "3.1.0",
  "info": {
    "description": "API for managing public transport stops in Think different Academy.",
    "title": "Think different Transit API",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "description": "Operations related to public transport lines",
      "name": "Lines"
    },
    {
      "description": "Service health",
      "name": "Health"
    },
    {
      "description": "Team information",
      "name": "Team"
    },
    {
      "description": "Stop management",
      "name": "Stops"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Health detail"
          }
        },
        "summary": "Get health detail",
        "tags": ["Health"]
      }
    },
    "/lines": {
      "get": {
        "operationId": "getLines",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Line"
                  }
                }
              }
            },
            "description": "List of lines"
          }
        },
        "summary": "List all lines",
        "tags": ["Lines"]
      },
      "post": {
        "operationId": "createLine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LineInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Line"
                }
              }
            },
            "description": "Line created successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid line ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a new line",
        "tags": ["Lines"]
      }
    },
    "/lines/{id}": {
      "delete": {
        "operationId": "deleteLine",
        "parameters": [
          {
            "description": "Line ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Line deleted successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid line ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Line not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Delete a line",
        "tags": ["Lines"]
      },
      "get": {
        "description": "Returns the details of a specific line, including its routes (one per direction).",
        "operationId": "getLine",
        "parameters": [
          {
            "description": "Line ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LineDetail"
                }
              }
            },
            "description": "Line detail"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid line ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Line not found"
          }
        },
        "summary": "Get line detail",
        "tags": ["Lines"]
      },
      "put": {
        "description": "Replaces the data of an existing line.",
        "operationId": "updateLine",
        "parameters": [
          {
            "description": "Line ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LineInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Line"
                }
              }
            },
            "description": "Line updated successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid line ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Line not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a line",
        "tags": ["Lines"]
      }
    },
    "/stops": {
      "get": {
        "operationId": "getStops",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Stop"
                  }
                }
              }
            },
            "description": "List of stops"
          }
        },
        "summary": "List all stops",
        "tags": ["Stops"]
      },
      "post": {
        "operationId": "createStop",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop created successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a new stop",
        "tags": ["Stops"]
      }
    },
    "/stops/{id}": {
      "delete": {
        "operationId": "deleteStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Stop deleted successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Delete a stop",
        "tags": ["Stops"]
      },
      "get": {
        "operationId": "getStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop detail"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "summary": "Get stop detail",
        "tags": ["Stops"]
      },
      "put": {
        "description": "Replaces the editable data of an existing stop. The complete StopInput object must be provided.",
        "operationId": "updateStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop updated successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid admin API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a stop",
        "tags": ["Stops"]
      }
    },
    "/stops/{id}/lines": {
      "get": {
        "description": "Returns every line with a route that passes through the stop.",
        "operationId": "getStopLines",
        "parameters": [
          {
            "description": "Line ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Line"
                  }
                }
              }
            },
            "description": "List of lines"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid line ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Line not found"
          }
        },
        "summary": "List lines serving a stop",
        "tags": ["Lines"]
      }
    },
    "/team": {
      "get": {
        "operationId": "getTeam",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            },
            "description": "Team detail"
          }
        },
        "summary": "Get team detail",
        "tags": ["Team"]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "example": "Stop not found"
          }
        },
        "required": ["error"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "Line": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string",
            "example": "#4F46E5"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "example": "Campus Express",
            "maxLength": 255
          },
          "number": {
            "type": "string",
            "example": "42",
            "maxLength": 20
          },
          "type": {
            "type": "string",
            "example": "bus",
            "maxLength": 50
          }
        },
        "required": ["color", "id", "name", "number", "type"]
      },
      "LineDetail": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string",
            "example": "#4F46E5"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "example": "Campus Express",
            "maxLength": 255
          },
          "number": {
            "type": "string",
            "example": "42",
            "maxLength": 20
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          },
          "type": {
            "type": "string",
            "example": "bus",
            "maxLength": 50
          }
        },
        "required": ["color", "id", "name", "number", "routes", "type"]
      },
      "LineInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "color": {
            "type": "string",
            "example": "#4F46E5",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "name": {
            "type": "string",
            "example": "Campus Express",
            "maxLength": 255,
            "minLength": 0
          },
          "number": {
            "type": "string",
            "example": "42",
            "maxLength": 20,
            "minLength": 0
          },
          "type": {
            "type": "string",
            "example": "bus",
            "maxLength": 50,
            "minLength": 0
          }
        },
        "required": ["color", "name", "number", "type"]
      },
      "Route": {
        "type": "object",
        "properties": {
          "bound": {
            "type": "string",
            "description": "Outbound leaves the line's first stop, inbound returns to it.",
            "enum": ["outbound", "inbound"]
          },
          "direction": {
            "type": "string",
            "description": "Where the route heads, i.e. the name of its last stop.",
            "example": "Notebook Quay",
            "maxLength": 255
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 12
          },
          "stops": {
            "type": "array",
            "description": "Stops in travel order.",
            "items": {
              "$ref": "#/components/schemas/RouteStop"
            }
          }
        },
        "required": ["bound", "direction", "id", "stops"]
      },
      "RouteStop": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Stop ID",
            "example": 4
          },
          "name": {
            "type": "string",
            "example": "Byte Square"
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "description": "1-based order on the route",
            "example": 1
          }
        },
        "required": ["id", "name", "position"]
      },
      "Stop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "has_shelter": {
            "type": "boolean"
          },
          "has_ticket_machine": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "image_url": {
            "type": ["string", "null"],
            "format": "uri",
            "maxLength": 255,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "wheelchair_accessible": {
            "type": "boolean"
          }
        },
        "required": [
          "has_shelter",
          "has_ticket_machine",
          "id",
          "image_url",
          "name",
          "wheelchair_accessible"
        ]
      },
      "StopInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "has_shelter": {
            "type": "boolean"
          },
          "has_ticket_machine": {
            "type": "boolean"
          },
          "image_url": {
            "type": ["string", "null"],
            "format": "uri",
            "maxLength": 255,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "wheelchair_accessible": {
            "type": "boolean"
          }
        },
        "required": ["has_shelter", "has_ticket_machine", "name", "wheelchair_accessible"]
      },
      "TeamResponse": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["members", "name"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Admin API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
